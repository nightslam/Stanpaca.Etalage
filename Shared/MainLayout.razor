@using MudBlazor
@inherits LayoutComponentBase
@inject IDialogService DialogService

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary">
        <MudImage Src="images/logo/logo.jpg" Alt="Stanpaca" Style="height: 48px; border-radius: 4px;" />
        <MudText Typo="Typo.h6" Class="ml-3" Style="color: white; font-weight: 600; letter-spacing: 1px;">
            Stanpaca
        </MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.MailOutline"
                   OnClick="OpenOrderDialog"
                   Style="border-color: rgba(255,255,255,0.6); color: white;">
            Aanvraag indienen
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private Task OpenOrderDialog() =>
        DialogService.ShowAsync<OrderDialog>("Aanvraag indienen");
}
